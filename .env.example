# Kopiera den här filen till .env.local och fyll i värdet.
# Supabase: Connect → Connection string → "Transaction pooler" (port 6543).
# Byt [YOUR-PASSWORD] mot databaslösenordet du valde när projektet skapades.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
